<Application x:Class="TimeSeriesSonifier.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F9FB"/><SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="PrimaryBlueBrush" Color="#1976D2"/><SolidColorBrush x:Key="SecondaryGreenBrush" Color="#20A464"/><SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2933"/><SolidColorBrush x:Key="SecondaryTextBrush" Color="#65727E"/><SolidColorBrush x:Key="BorderBrush" Color="#D9E1E8"/><SolidColorBrush x:Key="MutedBackgroundBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="GraphBackgroundBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="GridBrush" Color="#E1E7EC"/><SolidColorBrush x:Key="GraphLineBrush" Color="#1976D2"/><SolidColorBrush x:Key="SpectrumFillBrush" Color="#4120A464"/><SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="4"/><Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="5,3"/></Style>
  </Application.Resources>
</Application>
