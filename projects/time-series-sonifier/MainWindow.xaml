<Window x:Class="TimeSeriesSonifier.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Time-Series Sonifier" Width="1280" Height="820" MinWidth="900" MinHeight="600" Background="#10151B" Foreground="#D8E4EF">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="#18232D" Padding="12" CornerRadius="4"><DockPanel><TextBlock Text="TIME-SERIES SONIFIER" FontSize="22" FontWeight="Bold" Foreground="#8DE0FF"/><Button DockPanel.Dock="Right" Content="OPEN DATA" Padding="18,6" Click="OpenData_Click"/></DockPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="#18232D" Padding="12,8" Margin="0,12,0,0"><StackPanel><Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="TimelineSlider_Changed"/><DockPanel Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Content="PLAY" Click="Play_Click"/><Button Content="PAUSE" Click="Pause_Click"/><Button Content="RESET" Click="Reset_Click"/><CheckBox x:Name="LoopCheck" Content="LOOP" Margin="16,5,0,0"/></StackPanel><ComboBox x:Name="SpeedBox" Width="80" SelectedIndex="1" SelectionChanged="Speed_Changed"><ComboBoxItem>0.5x</ComboBoxItem><ComboBoxItem>1x</ComboBoxItem><ComboBoxItem>2x</ComboBoxItem><ComboBoxItem>4x</ComboBoxItem></ComboBox></DockPanel></StackPanel></Border>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#0B1015" BorderBrush="#263A49" BorderThickness="1"><local:GraphSurface x:Name="Graph" xmlns:local="clr-namespace:TimeSeriesSonifier"/></Border><ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><GroupBox Header="CURRENT DATA"><StackPanel Margin="10"><TextBlock Text="CURRENT TIME" Foreground="#9AAABA"/><TextBlock x:Name="CurrentTimeText" FontSize="16"/><TextBlock Text="CURRENT VALUE" Foreground="#9AAABA" Margin="0,10,0,0"/><TextBlock x:Name="CurrentValueText" FontSize="16"/></StackPanel></GroupBox><GroupBox Header="DATA"><StackPanel Margin="10"><TextBlock x:Name="SourceText" Text="No dataset loaded" TextWrapping="Wrap"/><TextBlock Text="TIME COLUMN" Foreground="#9AAABA" Margin="0,12,0,2"/><ComboBox x:Name="TimeColumnBox" SelectionChanged="Column_Changed"/><TextBlock Text="VALUE COLUMN" Foreground="#9AAABA" Margin="0,10,0,2"/><ComboBox x:Name="ValueColumnBox" SelectionChanged="Column_Changed"/><TextBlock x:Name="RowsText" Text="Select a time and value column" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></GroupBox><TextBlock x:Name="StatusText" Text="No dataset loaded" Foreground="#74E39B" Margin="4,12,4,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
  </DockPanel>
</Window>
