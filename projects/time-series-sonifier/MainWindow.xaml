<Window x:Class="TimeSeriesSonifier.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TimeSeriesSonifier" Title="Time-Series Sonifier" Width="1280" Height="980" MinWidth="900" MinHeight="700" Background="#10151B" Foreground="#D8E4EF">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="#18232D" Padding="12" CornerRadius="4"><DockPanel><TextBlock Text="TIME-SERIES SONIFIER" FontSize="22" FontWeight="Bold" Foreground="#8DE0FF"/><Button DockPanel.Dock="Right" Content="OPEN DATA" Padding="18,6" Click="OpenData_Click"/></DockPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="#18232D" Padding="12,8" Margin="0,12,0,0"><StackPanel><Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="TimelineSlider_Changed"/><DockPanel Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Content="PLAY" Click="Play_Click"/><Button Content="PAUSE" Click="Pause_Click"/><Button Content="RESET" Click="Reset_Click"/><CheckBox x:Name="LoopCheck" Content="LOOP" Margin="16,5,0,0"/></StackPanel><ComboBox x:Name="SpeedBox" Width="80" SelectedIndex="1" SelectionChanged="Speed_Changed"><ComboBoxItem>0.5x</ComboBoxItem><ComboBoxItem>1x</ComboBoxItem><ComboBoxItem>2x</ComboBoxItem><ComboBoxItem>4x</ComboBoxItem></ComboBox></DockPanel></StackPanel></Border>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#0B1015" BorderBrush="#263A49" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="190"/></Grid.RowDefinitions><Grid><local:GraphSurface x:Name="Graph"/><Canvas x:Name="IconOverlay" IsHitTestVisible="False"><Image x:Name="IconImage" Visibility="Collapsed" Stretch="Uniform"/></Canvas></Grid><Border Grid.Row="1" Margin="8" Background="#0B1015"><local:SpectrumSurface x:Name="Spectrum"/></Border></Grid></Border>
      <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
        <GroupBox Header="CURRENT DATA"><StackPanel Margin="10"><TextBlock Text="CURRENT TIME" Foreground="#9AAABA"/><TextBlock x:Name="CurrentTimeText" FontSize="16"/><TextBlock Text="SOURCE VALUE" Foreground="#9AAABA" Margin="0,10,0,0"/><TextBlock x:Name="CurrentOriginalText" FontSize="16"/><TextBlock Text="MAPPED VALUE" Foreground="#9AAABA" Margin="0,10,0,0"/><TextBlock x:Name="CurrentMappedText" FontSize="16"/><TextBlock Text="NORMALIZED" Foreground="#9AAABA" Margin="0,10,0,0"/><TextBlock x:Name="CurrentNormalizedText" FontSize="16"/></StackPanel></GroupBox>
        <GroupBox Header="DATA"><StackPanel Margin="10"><TextBlock x:Name="SourceText" Text="No dataset loaded" TextWrapping="Wrap"/><TextBlock x:Name="FormatText" Text="Format: —" Foreground="#9AAABA"/><TextBlock Text="TIME COLUMN" Foreground="#9AAABA" Margin="0,12,0,2"/><ComboBox x:Name="TimeColumnBox" SelectionChanged="Column_Changed"/><TextBlock Text="VALUE COLUMN" Foreground="#9AAABA" Margin="0,10,0,2"/><ComboBox x:Name="ValueColumnBox" SelectionChanged="Column_Changed"/><TextBlock Text="MAPPING MODE" Foreground="#9AAABA" Margin="0,10,0,2"/><ComboBox x:Name="MappingModeBox" SelectedIndex="0" SelectionChanged="MappingMode_Changed"><ComboBoxItem Content="Absolute Value" Tag="AbsoluteValue"/><ComboBoxItem Content="Change From Previous" Tag="ChangeFromPrevious"/><ComboBoxItem Content="Percent Change" Tag="PercentChange"/></ComboBox><TextBlock x:Name="RowsText" Text="Select a time and value column" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></GroupBox>
        <GroupBox Header="AUDIO"><StackPanel Margin="10"><CheckBox x:Name="AudioEnableCheck" Content="AUDIO ENABLED" Click="AudioEnable_Click"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="START SOUND" Click="StartSound_Click"/><Button Content="STOP SOUND" Click="StopSound_Click"/></StackPanel><TextBlock Text="WAVEFORM" Foreground="#9AAABA" Margin="0,10,0,2"/><ComboBox x:Name="WaveformBox" SelectedIndex="0" SelectionChanged="Waveform_Changed"><ComboBoxItem>Sine</ComboBoxItem><ComboBoxItem>Triangle</ComboBoxItem><ComboBoxItem>Square</ComboBoxItem><ComboBoxItem>Saw</ComboBoxItem></ComboBox><TextBlock Text="MIN PITCH (HZ)" Foreground="#9AAABA" Margin="0,8,0,2"/><TextBox x:Name="MinPitchBox" Text="110" LostFocus="PitchSettings_Changed"/><TextBlock Text="MAX PITCH (HZ)" Foreground="#9AAABA" Margin="0,8,0,2"/><TextBox x:Name="MaxPitchBox" Text="1760" LostFocus="PitchSettings_Changed"/><TextBlock Text="VOLUME" Foreground="#9AAABA" Margin="0,8,0,2"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.25" ValueChanged="Volume_Changed"/><TextBlock x:Name="TargetFrequencyText" Text="TARGET: —"/><TextBlock x:Name="CurrentFrequencyText" Text="CURRENT: —"/><TextBlock x:Name="AudioStatusText" Text="STATUS: Stopped" Foreground="#74E39B" TextWrapping="Wrap"/></StackPanel></GroupBox>
        <GroupBox Header="FFT / SPECTRUM"><StackPanel Margin="10"><CheckBox x:Name="SpectrumEnableCheck" Content="SPECTRUM ENABLED" Click="SpectrumEnable_Click"/><TextBlock Text="FFT SIZE" Foreground="#9AAABA" Margin="0,10,0,2"/><ComboBox x:Name="FftSizeBox" SelectedIndex="1" SelectionChanged="FftSize_Changed"><ComboBoxItem>1024</ComboBoxItem><ComboBoxItem>2048</ComboBoxItem><ComboBoxItem>4096</ComboBoxItem></ComboBox><TextBlock x:Name="SpectrumStatusText" Text="Spectrum disabled" Foreground="#74E39B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></GroupBox>
        <GroupBox Header="ICON"><StackPanel Margin="10"><Button Content="LOAD IMAGE" Click="LoadImage_Click"/><CheckBox x:Name="IconEnabledCheck" Content="ICON ENABLED" IsChecked="False" Click="IconSetting_Changed" Margin="0,8,0,0"/><CheckBox x:Name="ScaleWithDataCheck" Content="SCALE WITH DATA" IsChecked="True" Click="IconSetting_Changed"/><TextBlock x:Name="IconFileText" Text="No image loaded" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="MIN SCALE" Foreground="#9AAABA" Margin="0,8,0,2"/><TextBox x:Name="MinScaleBox" Text="0.5" LostFocus="IconScale_Changed"/><TextBlock Text="MAX SCALE" Foreground="#9AAABA" Margin="0,8,0,2"/><TextBox x:Name="MaxScaleBox" Text="1.5" LostFocus="IconScale_Changed"/><TextBlock x:Name="IconStatusText" Text="No image loaded" Foreground="#74E39B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></GroupBox>
        <TextBlock x:Name="StatusText" Text="No dataset loaded" Foreground="#74E39B" Margin="4,12,4,0" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
