<Window x:Class="TimeSeriesSonifier.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TimeSeriesSonifier" Title="Time-Series Sonifier" Width="1280" Height="980" MinWidth="900" MinHeight="700" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" CornerRadius="5"><DockPanel><TextBlock Text="TIME-SERIES SONIFIER" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/><Button DockPanel.Dock="Right" Content="OPEN DATA" Background="{StaticResource PrimaryBlueBrush}" Foreground="White" Padding="18,6" Click="OpenData_Click"/></DockPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,12,0,0"><StackPanel><Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="TimelineSlider_Changed"/><DockPanel Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Content="PLAY" Background="{StaticResource PrimaryBlueBrush}" Foreground="White" Click="Play_Click"/><Button Content="PAUSE" Click="Pause_Click"/><Button Content="RESET" Click="Reset_Click"/><CheckBox x:Name="LoopCheck" Content="LOOP" Margin="16,5,0,0"/></StackPanel><ComboBox x:Name="SpeedBox" Width="80" SelectedIndex="1" SelectionChanged="Speed_Changed"><ComboBoxItem>0.5x</ComboBoxItem><ComboBoxItem>1x</ComboBoxItem><ComboBoxItem>2x</ComboBoxItem><ComboBoxItem>4x</ComboBoxItem></ComboBox></DockPanel></StackPanel></Border>
    <TabControl x:Name="WorkflowTabs" Margin="0,12,0,0">
      <TabItem Header="SETUP"><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="190"/></Grid.RowDefinitions><Grid><Canvas x:Name="IconOverlay" IsHitTestVisible="False" Background="Transparent"><Image x:Name="IconImage" Visibility="Collapsed" Stretch="Uniform"/></Canvas><local:GraphSurface x:Name="Graph"/></Grid><Border Grid.Row="1" Margin="8" Background="{StaticResource PanelBackgroundBrush}"><local:SpectrumSurface x:Name="Spectrum"/></Border></Grid></Border><ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><GroupBox Header="CURRENT DATA"><StackPanel Margin="10"><TextBlock Text="CURRENT TIME" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="CurrentTimeText" FontSize="16"/><TextBlock Text="SOURCE VALUE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0"/><TextBlock x:Name="CurrentOriginalText" FontSize="16"/><TextBlock Text="MAPPED VALUE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0"/><TextBlock x:Name="CurrentMappedText" FontSize="16"/><TextBlock Text="NORMALIZED" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0"/><TextBlock x:Name="CurrentNormalizedText" FontSize="16"/></StackPanel></GroupBox><GroupBox Header="DATA"><StackPanel Margin="10"><TextBlock x:Name="SourceText" Text="No dataset loaded" TextWrapping="Wrap"/><TextBlock x:Name="FormatText" Text="Format: —" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="TIME COLUMN" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,2"/><ComboBox x:Name="TimeColumnBox" SelectionChanged="Column_Changed"/><TextBlock Text="VALUE COLUMN" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,2"/><ComboBox x:Name="ValueColumnBox" SelectionChanged="Column_Changed"/><TextBlock Text="MAPPING MODE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,2"/><ComboBox x:Name="MappingModeBox" SelectedIndex="0" SelectionChanged="MappingMode_Changed"><ComboBoxItem Content="Absolute Value" Tag="AbsoluteValue"/><ComboBoxItem Content="Change From Previous" Tag="ChangeFromPrevious"/><ComboBoxItem Content="Percent Change" Tag="PercentChange"/></ComboBox><TextBlock x:Name="RowsText" Text="Select a time and value column" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="AUDIO"><StackPanel Margin="10"><CheckBox x:Name="AudioEnableCheck" Content="AUDIO ENABLED" Click="AudioEnable_Click"/><TextBlock Text="WAVEFORM" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,2"/><ComboBox x:Name="WaveformBox" SelectedIndex="0" SelectionChanged="Waveform_Changed"><ComboBoxItem>Sine</ComboBoxItem><ComboBoxItem>Triangle</ComboBoxItem><ComboBoxItem>Square</ComboBoxItem><ComboBoxItem>Saw</ComboBoxItem></ComboBox><TextBlock Text="MIN PITCH (HZ)" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><TextBox x:Name="MinPitchBox" Text="110" LostFocus="PitchSettings_Changed"/><TextBlock Text="MAX PITCH (HZ)" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><TextBox x:Name="MaxPitchBox" Text="1760" LostFocus="PitchSettings_Changed"/><TextBlock Text="VOLUME" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.25" ValueChanged="Volume_Changed"/><TextBlock x:Name="TargetFrequencyText" Text="TARGET: —"/><TextBlock x:Name="CurrentFrequencyText" Text="CURRENT: —"/><TextBlock x:Name="AudioStatusText" Text="STATUS: Stopped" Foreground="{StaticResource SecondaryGreenBrush}" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="FFT / SPECTRUM"><StackPanel Margin="10"><CheckBox x:Name="SpectrumEnableCheck" Content="SPECTRUM ENABLED" Click="SpectrumEnable_Click"/><TextBlock Text="FFT SIZE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,2"/><ComboBox x:Name="FftSizeBox" SelectedIndex="1" SelectionChanged="FftSize_Changed"><ComboBoxItem>1024</ComboBoxItem><ComboBoxItem>2048</ComboBoxItem><ComboBoxItem>4096</ComboBoxItem></ComboBox><TextBlock x:Name="SpectrumStatusText" Text="Spectrum disabled" Foreground="{StaticResource SecondaryGreenBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="IMAGE"><StackPanel Margin="10"><Button Content="LOAD IMAGE" Click="LoadImage_Click"/><Button Content="USE DEFAULT CUBE" Click="UseDefaultImage_Click"/><CheckBox x:Name="IconEnabledCheck" Content="IMAGE ENABLED" IsChecked="False" Click="IconSetting_Changed" Margin="0,8,0,0"/><CheckBox x:Name="ScaleWithDataCheck" Content="SCALE WITH DATA" IsChecked="True" Click="IconSetting_Changed"/><TextBlock x:Name="IconFileText" Text="Default gray cube" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="MIN SCALE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><TextBox x:Name="MinScaleBox" Text="0.5" LostFocus="IconScale_Changed"/><TextBlock Text="MAX SCALE" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><TextBox x:Name="MaxScaleBox" Text="1.5" LostFocus="IconScale_Changed"/><TextBlock Text="IMAGE OPACITY" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,2"/><Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="1" Value="0.35" ValueChanged="ImageOpacity_Changed"/><TextBlock x:Name="ImageOpacityText" Text="OPACITY: 35%" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="IconStatusText" Text="No image loaded" Foreground="{StaticResource SecondaryGreenBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></GroupBox><TextBlock x:Name="StatusText" Text="No dataset loaded" Foreground="{StaticResource SecondaryGreenBrush}" Margin="4,12,4,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></TabItem>
      <TabItem Header="PRE-VISUALIZATION"><Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBackgroundBrush}"><local:PresentationSurface x:Name="PreviewSurface" Width="720" Height="405"/></Grid></TabItem>
      <TabItem Header="FINAL OUTPUT"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="150"/></Grid.RowDefinitions><Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"><local:PresentationSurface x:Name="OutputSurface" Width="300" Height="533"/></Grid><StackPanel Grid.Row="1" Width="360" HorizontalAlignment="Center" Margin="0,10"><TextBlock Text="OUTPUT PROFILE" Foreground="{StaticResource SecondaryTextBrush}"/><ComboBox x:Name="OutputProfileBox" SelectedIndex="0" SelectionChanged="OutputProfile_Changed"/><DockPanel Margin="0,8,0,0"><TextBlock Text="FRAME RATE" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/><ComboBox x:Name="FrameRateBox" Width="90" HorizontalAlignment="Right" SelectedIndex="0"><ComboBoxItem>30 FPS</ComboBoxItem><ComboBoxItem>60 FPS</ComboBoxItem></ComboBox></DockPanel><Button Content="EXPORT MP4" Background="{StaticResource PrimaryBlueBrush}" Foreground="White" Click="Export_Click" Margin="0,8,0,0"/><TextBlock x:Name="ExportStatusText" Text="1080 × 1920 · 30 FPS · 10.0 sec" Foreground="{StaticResource SecondaryGreenBrush}" TextWrapping="Wrap"/></StackPanel></Grid></TabItem>
    </TabControl>
  </DockPanel>
</Window>
