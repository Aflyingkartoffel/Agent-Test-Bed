<Window x:Class="InsectLightSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insect Light Simulation" Width="1280" Height="800"
        MinWidth="900" MinHeight="600" Background="#020502" Foreground="#7CFF74"
        FontFamily="Consolas" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="INSECT LIGHT SIM" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="v0.1.0   /   PROCEDURAL ANIMATION LAB" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="#3CB84B" />
            <Button x:Name="PauseButton" Content="PAUSE" Click="PauseButton_Click" Width="90" Margin="12,0,0,0" />
            <Button Content="RESET" Click="ResetButton_Click" Width="90" Margin="8,0,0,0" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#247A31" BorderThickness="1" Background="Black" Padding="1">
                <Image x:Name="Viewport" Stretch="Fill" SnapsToDevicePixels="True" />
            </Border>
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SIMULATION" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="SPEED" Foreground="#3CB84B" />
                    <ComboBox x:Name="SpeedBox" SelectedIndex="2" Margin="0,3,0,10" SelectionChanged="SpeedBox_SelectionChanged">
                        <ComboBoxItem Content="0.25x" /><ComboBoxItem Content="0.5x" /><ComboBoxItem Content="1.0x" /><ComboBoxItem Content="2.0x" /><ComboBoxItem Content="4.0x" />
                    </ComboBox>
                    <TextBlock Text="INSECT COUNT" Foreground="#3CB84B" />
                    <Slider x:Name="CountSlider" Minimum="10" Maximum="2000" Value="500" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="CountSlider_ValueChanged" />
                    <TextBlock x:Name="CountValue" Text="500" HorizontalAlignment="Right" Margin="0,-4,0,10" />
                    <TextBlock Text="LIGHT" FontWeight="Bold" Margin="0,4,0,8" />
                    <TextBlock Text="ATTRACTION STRENGTH" Foreground="#3CB84B" /><Slider x:Name="AttractionSlider" Minimum="0" Maximum="3" Value="1.25" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="INFLUENCE RADIUS" Foreground="#3CB84B" /><Slider x:Name="RadiusSlider" Minimum="80" Maximum="700" Value="360" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="LIGHT INTENSITY" Foreground="#3CB84B" /><Slider x:Name="IntensitySlider" Minimum="0.2" Maximum="2" Value="1" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="BEHAVIOR" FontWeight="Bold" Margin="0,16,0,8" />
                    <TextBlock Text="BASE SPEED" Foreground="#3CB84B" /><Slider x:Name="SpeedSlider" Minimum="20" Maximum="150" Value="72" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="TURN RATE" Foreground="#3CB84B" /><Slider x:Name="TurnSlider" Minimum="0.5" Maximum="8" Value="3.4" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="WANDER STRENGTH" Foreground="#3CB84B" /><Slider x:Name="WanderSlider" Minimum="0" Maximum="2" Value="0.75" ValueChanged="SettingSlider_ValueChanged" />
                    <TextBlock Text="BOUNDARY" Foreground="#3CB84B" Margin="0,8,0,2" />
                    <ComboBox x:Name="BoundaryBox" SelectedIndex="0" SelectionChanged="BoundaryBox_SelectionChanged"><ComboBoxItem Content="WRAPAROUND" /><ComboBoxItem Content="SOFT BOUNCE" /></ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatsText" Text="SIM TIME 0.0s   FPS --   INSECTS 500   AVG SPEED --" VerticalAlignment="Center" />
            <TextBlock Text="BLACK FIELD / GREEN AGENTS / PSEUDO LIGHT" Foreground="#3CB84B" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
