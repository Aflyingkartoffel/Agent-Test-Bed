<Window x:Class="CreatureConstructionLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Creature Construction Laboratory" Width="1250" Height="780" MinWidth="900" MinHeight="560" Background="#020604" FontFamily="Consolas" KeyDown="Window_KeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock Text="CREATURE LAB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="  /  PROCEDURAL CONSTRUCTION" Foreground="#3D9A6A" VerticalAlignment="Center" Margin="12,0,24,0" />
      <Button x:Name="CreateModeButton" Content="CREATE" Click="CreateMode_Click" Width="88" Margin="0,0,6,0" />
      <Button x:Name="PlayModeButton" Content="PLAY" Click="PlayMode_Click" Width="88" Margin="0,0,18,0" />
      <Button Content="RESET" Click="Reset_Click" Width="88" />
    </DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#277A51" BorderThickness="1"><ContentControl x:Name="CanvasHost"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="TOOLS" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal"><Button x:Name="NodeToolButton" Content="NODE" Click="NodeTool_Click" Width="108" Margin="0,0,6,0"/><Button x:Name="SelectToolButton" Content="SELECT" Click="SelectTool_Click" Width="108"/></StackPanel>
        <TextBlock Text="NODE TOOL: click empty canvas to create" Foreground="#3D9A6A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,20" />
        <TextBlock Text="SELECTED NODE" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock x:Name="SelectionText" Text="NONE" Foreground="#3D9A6A" Margin="0,0,0,12" />
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Position X" Grid.Row="0"/><TextBox x:Name="XBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
          <TextBlock Text="Position Y" Grid.Row="1"/><TextBox x:Name="YBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
          <TextBlock Text="Radius" Grid.Row="2"/><TextBox x:Name="RadiusBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
          <TextBlock Text="Rotation" Grid.Row="3"/><TextBox x:Name="RotationBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
        </Grid>
        <TextBlock Text="Drag nodes to move. Press DELETE to remove the selection." Foreground="#3D9A6A" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="CREATE MODE  /  0 NODES" Foreground="#3D9A6A" VerticalAlignment="Center" />
  </Grid>
</Window>
