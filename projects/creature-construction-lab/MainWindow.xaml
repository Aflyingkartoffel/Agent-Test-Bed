<Window x:Class="CreatureConstructionLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Creature Construction Laboratory" Width="1250" Height="820" MinWidth="900" MinHeight="560" Background="#020604" FontFamily="Consolas" KeyDown="Window_KeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False"><TextBlock Text="CREATURE LAB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="  /  PROCEDURAL CONSTRUCTION" Foreground="#3D9A6A" VerticalAlignment="Center" Margin="12,0,24,0"/><Button x:Name="CreateModeButton" Content="CREATE" Click="CreateMode_Click" Width="88" Margin="0,0,6,0"/><Button x:Name="PlayModeButton" Content="PLAY" Click="PlayMode_Click" Width="88" Margin="0,0,18,0"/><Button Content="NEW" Click="Reset_Click" Width="72" Margin="0,0,6,0"/><Button Content="SAVE" Click="Save_Click" Width="72" Margin="0,0,6,0"/><Button Content="LOAD" Click="Load_Click" Width="72"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border Grid.Column="0" BorderBrush="#277A51" BorderThickness="1"><ContentControl x:Name="CanvasHost"/></Border><ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"><Grid>
      <StackPanel x:Name="CreatePanel">
        <TextBlock Text="CONSTRUCTION" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button Content="NODE" Click="NodeTool_Click" Width="82" Margin="0,0,5,0"/><Button Content="SELECT" Click="SelectTool_Click" Width="82" Margin="0,0,5,0"/><Button Content="DELETE" Click="Delete_Click" Width="82"/></StackPanel><Button x:Name="AddNextButton" Content="ADD NEXT NODE" Click="AddNextNode_Click" Margin="0,8,0,16"/>
        <TextBlock Text="CHAIN" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Spacing" Width="95"/><TextBox x:Name="SpacingBox" Width="125" LostFocus="ChainProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Stiffness" Width="95"/><TextBox x:Name="StiffnessBox" Width="125" LostFocus="ChainProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Damping" Width="95"/><TextBox x:Name="DampingBox" Width="125" LostFocus="ChainProperty_LostFocus"/></StackPanel>
        <TextBlock Text="BODY SIZE" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Base Radius" Width="95"/><TextBox x:Name="BaseRadiusBox" Width="125" LostFocus="BaseRadius_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Interpolation" Width="95"/><ComboBox x:Name="InterpolationBox" Width="125" SelectionChanged="Interpolation_Changed"><ComboBoxItem Content="LINEAR"/><ComboBoxItem Content="SMOOTH"/><ComboBoxItem Content="BEZIER"/></ComboBox></StackPanel><ContentControl x:Name="RampHost" Height="130" Margin="0,0,0,6"/><Button x:Name="ResetCurveButton" Content="RESET CURVE" Click="ResetCurve_Click" Margin="0,0,0,14"/>
        <TextBlock Text="APPEARANCE" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Skin Color" Width="95" VerticalAlignment="Center"/><TextBox x:Name="SkinColorBox" Width="80" Text="#FF2E8B57" LostFocus="SkinColor_LostFocus"/><Button Content="PICK" Click="PickSkinColor_Click" Width="45" Margin="5,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="CreateShowNodesBox" Content="SHOW NODES" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed" Margin="0,0,12,0"/><CheckBox x:Name="CreateShowSkinBox" Content="SHOW SKIN" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed" Margin="0,0,12,0"/><CheckBox x:Name="CreateShowMusclesBox" Content="SHOW MUSCLES" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/></StackPanel>
        <TextBlock Text="FEATURES" FontSize="15" FontWeight="Bold" Margin="0,16,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><ComboBox x:Name="AddFeatureTypeBox" Width="125" SelectedIndex="0"><ComboBoxItem Content="Eye"/><ComboBoxItem Content="Forked Tongue"/></ComboBox><Button Content="+ ADD FEATURE" Click="AddFeature_Click" Margin="6,0,0,0"/></StackPanel><ComboBox x:Name="FeatureListBox" SelectionChanged="FeatureSelection_Changed" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="Type" Width="95"/><ComboBox x:Name="FeatureTypeBox" Width="125" SelectionChanged="FeatureProperty_Changed"><ComboBoxItem Content="Eye"/><ComboBoxItem Content="Forked Tongue"/></ComboBox></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Parent" Width="95"/><ComboBox x:Name="FeatureParentBox" Width="125" SelectionChanged="FeatureProperty_Changed"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Position X" Width="95"/><TextBox x:Name="FeatureXBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Position Y" Width="95"/><TextBox x:Name="FeatureYBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Rotation" Width="95"/><TextBox x:Name="FeatureRotationBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Scale" Width="95"/><TextBox x:Name="FeatureScaleBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel x:Name="EyeSettingsPanel" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Eye Width" Width="95"/><TextBox x:Name="FeatureEyeWidthBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Eye Height" Width="95"/><TextBox x:Name="FeatureEyeHeightBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Tracking" Width="95"/><TextBox x:Name="FeatureTrackingBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel></StackPanel><StackPanel x:Name="TongueSettingsPanel" Visibility="Collapsed" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Length" Width="95"/><TextBox x:Name="TongueLengthBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Fork Length" Width="95"/><TextBox x:Name="TongueForkLengthBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Fork Angle" Width="95"/><TextBox x:Name="TongueForkAngleBox" Width="125" LostFocus="FeatureProperty_LostFocus"/></StackPanel></StackPanel><CheckBox x:Name="FeatureMirrorBox" Content="MIRROR" Checked="FeatureProperty_Changed" Unchecked="FeatureProperty_Changed" Margin="0,6,0,0"/><CheckBox x:Name="FeatureVisibleBox" Content="VISIBLE" Checked="FeatureProperty_Changed" Unchecked="FeatureProperty_Changed" Margin="0,4,0,6"/><Button Content="DELETE FEATURE" Click="DeleteFeature_Click" Margin="0,0,0,14"/>
        <TextBlock Text="SELECTED NODE" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="SelectionText" Text="NONE" Foreground="#3D9A6A" Margin="0,0,0,10"/><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Position X" Grid.Row="0"/><TextBox x:Name="XBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" LostFocus="Property_LostFocus"/><TextBlock Text="Position Y" Grid.Row="1"/><TextBox x:Name="YBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" LostFocus="Property_LostFocus"/><TextBlock Text="Norm Pos" Grid.Row="2"/><TextBlock x:Name="NormalizedText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/><TextBlock Text="Ramp Value" Grid.Row="3"/><TextBlock x:Name="RampValueText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/><TextBlock Text="Radius" Grid.Row="4"/><TextBlock x:Name="RadiusText" Grid.Row="4" Grid.Column="1"/></Grid><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="Rotation" Width="95"/><TextBox x:Name="RotationBox" Width="125" LostFocus="Property_LostFocus"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="PlayPanel" Visibility="Collapsed"><TextBlock Text="SIMULATION" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="PlayPauseButton" Content="PAUSE" Click="PlayPause_Click" Width="125" Margin="0,0,6,0"/><Button Content="RESET SIMULATION" Click="ResetSimulation_Click" Width="125"/></StackPanel><TextBlock Text="Simulation Speed" Foreground="#3D9A6A" Margin="0,12,0,2"/><ComboBox x:Name="SimulationSpeedBox" SelectedIndex="3" SelectionChanged="SimulationSpeed_Changed"><ComboBoxItem Content="0.25x"/><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/></ComboBox><TextBlock Text="MOVEMENT" FontSize="15" FontWeight="Bold" Margin="0,16,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Max Speed" Width="95"/><TextBox x:Name="MaxSpeedBox" Width="125" LostFocus="PlaySetting_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Acceleration" Width="95"/><TextBox x:Name="AccelerationBox" Width="125" LostFocus="PlaySetting_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Damping" Width="95"/><TextBox x:Name="PlayDampingBox" Width="125" LostFocus="PlaySetting_LostFocus"/></StackPanel><TextBlock Text="BODY MOTION" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="WaveEnabledBox" Content="WAVE ENABLED" Checked="WaveSetting_Changed" Unchecked="WaveSetting_Changed" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Amplitude" Width="95"/><TextBox x:Name="WaveAmplitudeBox" Width="125" LostFocus="WaveSetting_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Frequency" Width="95"/><TextBox x:Name="WaveFrequencyBox" Width="125" LostFocus="WaveSetting_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Phase" Width="95"/><TextBox x:Name="WavePhaseBox" Width="125" LostFocus="WaveSetting_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Influence" Width="95"/><TextBox x:Name="WaveInfluenceBox" Width="125" LostFocus="WaveSetting_LostFocus"/></StackPanel><TextBlock Text="DISPLAY" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="PlayShowSkinBox" Content="SHOW SKIN" IsChecked="True" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/><CheckBox x:Name="PlaySolidBodyBox" Content="SOLID BODY" IsChecked="True" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/><CheckBox x:Name="PlayShowSkeletonBox" Content="SHOW SKELETON" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/><CheckBox x:Name="PlayShowMusclesBox" Content="SHOW MUSCLES" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/><CheckBox x:Name="PlayShowEyesBox" Content="SHOW FEATURES" Checked="DisplayToggle_Changed" Unchecked="DisplayToggle_Changed"/></StackPanel>
    </Grid></ScrollViewer></Grid><TextBlock Grid.Row="2" x:Name="StatusText" Text="CREATE MODE  /  0 NODES" Foreground="#3D9A6A" VerticalAlignment="Center"/>
  </Grid>
</Window>
