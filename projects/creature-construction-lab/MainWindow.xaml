<Window x:Class="CreatureConstructionLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Creature Construction Laboratory" Width="1250" Height="780" MinWidth="900" MinHeight="560" Background="#020604" FontFamily="Consolas" KeyDown="Window_KeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock Text="CREATURE LAB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Text="  /  PROCEDURAL CONSTRUCTION" Foreground="#3D9A6A" VerticalAlignment="Center" Margin="12,0,24,0" />
      <Button x:Name="CreateModeButton" Content="CREATE" Click="CreateMode_Click" Width="88" Margin="0,0,6,0" />
      <Button x:Name="PlayModeButton" Content="PLAY" Click="PlayMode_Click" Width="88" Margin="0,0,18,0" />
      <Button Content="RESET" Click="Reset_Click" Width="88" />
    </DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#277A51" BorderThickness="1"><ContentControl x:Name="CanvasHost"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="TOOLS" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal"><Button x:Name="NodeToolButton" Content="NODE" Click="NodeTool_Click" Width="108" Margin="0,0,6,0"/><Button x:Name="SelectToolButton" Content="SELECT" Click="SelectTool_Click" Width="108"/></StackPanel>
        <TextBlock Text="NODE TOOL: click empty canvas to create" Foreground="#3D9A6A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,20" />
        <TextBlock Text="CHAIN" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Spacing" Width="90" VerticalAlignment="Center"/><TextBox x:Name="SpacingBox" Text="50" Width="108" LostFocus="ChainProperty_LostFocus" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Stiffness" Width="90" VerticalAlignment="Center"/><TextBox x:Name="StiffnessBox" Text="1" Width="108" LostFocus="ChainProperty_LostFocus" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Damping" Width="90" VerticalAlignment="Center"/><TextBox x:Name="DampingBox" Text="0.1" Width="108" LostFocus="ChainProperty_LostFocus" /></StackPanel>
        <Button x:Name="AddNextButton" Content="ADD NEXT NODE" Click="AddNextNode_Click" Margin="0,6,0,20" />
        <StackPanel x:Name="PlayPanel" Visibility="Collapsed" Margin="0,0,0,18">
          <TextBlock Text="PLAY MODE" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal"><Button x:Name="PlayPauseButton" Content="PAUSE" Click="PlayPause_Click" Width="108" Margin="0,0,6,0"/><Button Content="RESET SIM" Click="ResetSimulation_Click" Width="108"/></StackPanel>
          <TextBlock Text="Simulation Speed" Foreground="#3D9A6A" Margin="0,10,0,2" />
          <ComboBox x:Name="SimulationSpeedBox" SelectedIndex="2" SelectionChanged="SimulationSpeed_Changed"><ComboBoxItem Content="0.25x"/><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="1.0x"/><ComboBoxItem Content="2.0x"/></ComboBox>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,4"><TextBlock Text="Max Speed" Width="90"/><TextBox x:Name="MaxSpeedBox" Width="108" LostFocus="PlaySetting_LostFocus"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="Acceleration" Width="90"/><TextBox x:Name="AccelerationBox" Width="108" LostFocus="PlaySetting_LostFocus"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Damping" Width="90"/><TextBox x:Name="PlayDampingBox" Width="108" LostFocus="PlaySetting_LostFocus"/></StackPanel>
        </StackPanel>
        <TextBlock Text="BODY SIZE" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <ContentControl x:Name="RampHost" Height="130" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Base Radius" Width="90" VerticalAlignment="Center"/><TextBox x:Name="BaseRadiusBox" Width="108" LostFocus="BaseRadius_LostFocus" /></StackPanel>
        <Button x:Name="ResetCurveButton" Content="RESET CURVE" Click="ResetCurve_Click" Margin="0,0,0,10" />
        <TextBlock Text="Double-click to add. Drag points to edit. Delete removes intermediate points." Foreground="#3D9A6A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock Text="SELECTED NODE" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock x:Name="SelectionText" Text="NONE" Foreground="#3D9A6A" Margin="0,0,0,12" />
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Position X" Grid.Row="0"/><TextBox x:Name="XBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
          <TextBlock Text="Position Y" Grid.Row="1"/><TextBox x:Name="YBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" LostFocus="Property_LostFocus" />
          <TextBlock Text="Norm Pos" Grid.Row="2"/><TextBlock x:Name="NormalizedText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
          <TextBlock Text="Ramp Value" Grid.Row="3"/><TextBlock x:Name="RampValueText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Radius" Width="90"/><TextBlock x:Name="RadiusText" /></StackPanel>
        <TextBlock Text="Derived from Body Size Ramp" Foreground="#3D9A6A" FontSize="11" Margin="0,2,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Rotation" Width="90"/><TextBox x:Name="RotationBox" Width="108" LostFocus="Property_LostFocus" /></StackPanel>
        <TextBlock x:Name="HelpText" Text="Drag the root to move the whole chain. Drag the bright direction handle to rotate. Press DELETE to remove the selected node and its descendants." Foreground="#3D9A6A" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="CREATE MODE  /  0 NODES" Foreground="#3D9A6A" VerticalAlignment="Center" />
  </Grid>
</Window>
