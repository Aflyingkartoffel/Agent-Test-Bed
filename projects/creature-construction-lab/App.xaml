<Application x:Class="CreatureConstructionLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B8FFB2"/><Setter Property="FontFamily" Value="Consolas"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#B8FFB2"/><Setter Property="Background" Value="#0A1B12"/><Setter Property="BorderBrush" Value="#277A51"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="FontFamily" Value="Consolas"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#123523"/><Setter Property="BorderBrush" Value="#64E69C"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#D8FFE0"/><Setter Property="Background" Value="#07110C"/><Setter Property="BorderBrush" Value="#277A51"/><Setter Property="Padding" Value="5,3"/><Setter Property="FontFamily" Value="Consolas"/></Style>
  </Application.Resources>
</Application>
