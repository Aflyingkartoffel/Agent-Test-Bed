<Window x:Class="EquationSynth.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Equation Synth" Width="1240" Height="860" MinWidth="980" MinHeight="680" Background="#10151B" Foreground="#D8E4EF">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#1D3444"/><Setter Property="Foreground" Value="#D8E4EF"/><Setter Property="BorderBrush" Value="#3C6A82"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="GroupBox"><Setter Property="Foreground" Value="#86D6F2"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<DockPanel Margin="14"><StackPanel DockPanel.Dock="Top"><TextBlock Text="EQUATION SYNTH" FontSize="24" FontWeight="Bold" Foreground="#8DE0FF"/><DockPanel Margin="0,10,0,4"><TextBox x:Name="EquationBox" Text="sin(x)" FontSize="18" Padding="8" Background="#18232D" Foreground="White" BorderBrush="#3C6A82" KeyDown="EquationBox_KeyDown"/><Button Content="APPLY" Click="Apply_Click" Width="90"/></DockPanel><DockPanel><TextBlock x:Name="StatusText" Text="✓ VALID" Foreground="#74E39B" FontWeight="Bold"/><TextBlock Text="   AUDIO SOURCE: SELECTED EQUATION" Foreground="#9AAABA"/></DockPanel></StackPanel>
<Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330" MinWidth="300"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="190" MinHeight="150"/></Grid.RowDefinitions><GroupBox Header="MATHEMATICAL GRAPH" Grid.Row="0"><DockPanel><TextBlock x:Name="CoordinateText" DockPanel.Dock="Bottom" Text="x = 0.000    y = 0.000" Foreground="#9AAABA" Margin="4"/><Canvas x:Name="GraphCanvas" Background="#0B1015" MouseWheel="Graph_MouseWheel" MouseLeftButtonDown="Graph_MouseDown" MouseLeftButtonUp="Graph_MouseUp" MouseMove="Graph_MouseMove" SizeChanged="Canvas_SizeChanged"/></DockPanel></GroupBox><GroupBox Header="AUDIO WAVEFORM" Grid.Row="1"><Canvas x:Name="WaveCanvas" Background="#0B1015" SizeChanged="Canvas_SizeChanged"/></GroupBox>
<ScrollViewer Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"><StackPanel><GroupBox Header="EQUATIONS"><StackPanel><StackPanel x:Name="EquationsPanel"/><Button Content="+ ADD EQUATION" Click="AddEquation_Click"/></StackPanel></GroupBox><GroupBox Header="EQUATION EDITOR"><StackPanel><TextBlock Text="Selected equation" Foreground="#9AAABA"/><TextBlock x:Name="SelectedColorText" Text="COLOR"/><StackPanel Orientation="Horizontal"><Button Content="CYAN" Click="Color_Click" Tag="#69DAFF"/><Button Content="ORANGE" Click="Color_Click" Tag="#FFB95D"/><Button Content="GREEN" Click="Color_Click" Tag="#74E39B"/><Button Content="PURPLE" Click="Color_Click" Tag="#C69CFF"/></StackPanel></StackPanel></GroupBox><GroupBox Header="PARAMETERS"><StackPanel x:Name="ParametersPanel"/></GroupBox><GroupBox Header="VIEW"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="X MIN"/><TextBox x:Name="XMinBox" Grid.Column="1" Text="-10"/><Button Grid.Column="2" Content="APPLY" Click="ViewApply_Click"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="X MAX"/><TextBox x:Name="XMaxBox" Grid.Column="1" Text="10"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Y MIN"/><TextBox x:Name="YMinBox" Grid.Column="1" Text="-5"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Y MAX"/><TextBox x:Name="YMaxBox" Grid.Column="1" Text="5"/></Grid><Button Content="RESET VIEW" Click="ResetView_Click"/></StackPanel></GroupBox><GroupBox Header="TIME"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="PLAY" Click="TimePlay_Click"/><Button Content="PAUSE" Click="TimePause_Click"/><Button Content="RESET" Click="TimeReset_Click"/></StackPanel><TextBlock x:Name="TimeText" Text="t = 0.000"/><DockPanel><TextBlock Text="SPEED" Width="55"/><Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="5" Value="1" ValueChanged="Setting_Changed"/><TextBlock x:Name="SpeedText" Width="42"/></DockPanel></StackPanel></GroupBox><GroupBox Header="AUDIO"><StackPanel><DockPanel><TextBlock Text="FREQUENCY" Width="78"/><Slider x:Name="FrequencySlider" Minimum="80" Maximum="1000" Value="440" ValueChanged="Setting_Changed"/><TextBlock x:Name="FrequencyText" Width="58"/></DockPanel><DockPanel><TextBlock Text="VOLUME" Width="78"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="0.5" Value="0.18" ValueChanged="Setting_Changed"/><TextBlock x:Name="VolumeText" Width="58"/></DockPanel><StackPanel Orientation="Horizontal"><Button Content="PLAY SOUND" Click="SoundPlay_Click"/><Button Content="STOP SOUND" Click="SoundStop_Click"/></StackPanel></StackPanel></GroupBox><GroupBox Header="PRESETS"><StackPanel><ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed"/><StackPanel Orientation="Horizontal"><Button Content="SAVE" Click="Save_Click"/><Button Content="LOAD" Click="Load_Click"/></StackPanel></StackPanel></GroupBox></StackPanel></ScrollViewer></Grid></DockPanel></Window>
