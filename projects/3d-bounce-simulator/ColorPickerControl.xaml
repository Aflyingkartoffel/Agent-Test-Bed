<UserControl x:Class="ParticleModelViewer.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="226">
  <StackPanel>
    <Border x:Name="PreviewBorder" Height="28" CornerRadius="5" BorderBrush="#3E4E70" BorderThickness="1" />
    <TextBlock Text="Hue / saturation wheel" Foreground="#94A3B8" Margin="0,8,0,3" />
    <Border BorderBrush="#3E4E70" BorderThickness="1" CornerRadius="3">
      <Image x:Name="ColorWheelImage" Width="180" Height="180" HorizontalAlignment="Center" Stretch="Fill"
             MouseLeftButtonDown="ColorWheelImage_MouseLeftButtonDown" MouseMove="ColorWheelImage_MouseMove"
             MouseLeftButtonUp="ColorWheelImage_MouseLeftButtonUp" LostMouseCapture="ColorWheelImage_LostMouseCapture" />
    </Border>
    <TextBlock Text="Brightness" Foreground="#94A3B8" Margin="0,8,0,0" />
    <Slider x:Name="ValueSlider" Minimum="0" Maximum="1" Value="1" TickFrequency="0.1" />
    <TextBlock x:Name="HexValueText" Foreground="#CBD5E1" HorizontalAlignment="Right" Margin="0,2,0,0" />
  </StackPanel>
</UserControl>
