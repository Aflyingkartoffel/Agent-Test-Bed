<Window x:Class="ParticleModelViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Particle Model Viewer" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="#090D16" Foreground="#F8FAFC">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="270" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="16" BorderBrush="#24324A" BorderThickness="1" Background="#0B1220">
      <Grid>
        <Viewport3D x:Name="Viewport" ClipToBounds="True" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel">
          <Viewport3D.Camera>
            <PerspectiveCamera x:Name="Camera" FieldOfView="45" Position="0,0,8" LookDirection="0,0,-8" UpDirection="0,1,0" />
          </Viewport3D.Camera>
          <ModelVisual3D>
            <ModelVisual3D.Content>
              <AmbientLight Color="#7886A8" />
            </ModelVisual3D.Content>
          </ModelVisual3D>
          <ModelVisual3D x:Name="SceneVisual" />
        </Viewport3D>
        <StackPanel Margin="18" VerticalAlignment="Top" IsHitTestVisible="False">
          <TextBlock Text="PARTICLE VIEWPORT" Foreground="#818CF8" FontSize="11" FontWeight="Bold" />
          <TextBlock x:Name="ViewportHint" Text="Load an OBJ model to begin" Margin="0,4,0,0" Foreground="#94A3B8" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="3D Particle Model Viewer" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Turn real mesh surfaces into an interactive point sculpture." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,20" />

        <Button x:Name="LoadButton" Content="Load model…" Click="LoadModel_Click" FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="No model loaded" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,18" />

        <Border BorderBrush="#24324A" BorderThickness="0,1,0,0" Padding="0,16,0,0">
          <StackPanel>
            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Particle color (hex)" Foreground="#94A3B8" Margin="0,12,0,4" />
            <DockPanel>
              <TextBox x:Name="ColorTextBox" Text="#818CF8" Padding="8" Background="#1B2740" Foreground="#F8FAFC" BorderBrush="#3E4E70" />
              <Button Content="Apply" Click="ApplyColor_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
            </DockPanel>
            <TextBlock Text="Particle count" Foreground="#94A3B8" Margin="0,14,0,2" />
            <Slider x:Name="DensitySlider" Minimum="200" Maximum="6000" Value="1600" TickFrequency="200" IsSnapToTickEnabled="True" ValueChanged="ParticleSettings_Changed" />
            <TextBlock x:Name="DensityValue" Text="1,600 particles" Foreground="#CBD5E1" HorizontalAlignment="Right" />
            <TextBlock Text="Particle size" Foreground="#94A3B8" Margin="0,14,0,2" />
            <Slider x:Name="SizeSlider" Minimum="0.01" Maximum="0.08" Value="0.035" TickFrequency="0.005" ValueChanged="ParticleSettings_Changed" />
            <TextBlock x:Name="SizeValue" Text="0.035" Foreground="#CBD5E1" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>

        <Border BorderBrush="#24324A" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="Rotation" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Model rotation (Y axis)" Foreground="#94A3B8" Margin="0,12,0,2" />
            <Slider x:Name="RotationSlider" Minimum="0" Maximum="360" Value="0" ValueChanged="RotationSlider_Changed" />
            <TextBlock x:Name="RotationValue" Text="0°" Foreground="#CBD5E1" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>

        <Button Content="Reset camera" Click="ResetCamera_Click" />
        <Button Content="Reset visualization" Click="ResetVisualization_Click" />
        <TextBlock Text="Drag to orbit • Scroll to zoom • R resets the camera" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
        <TextBlock Text="OBJ is supported in this phase. FBX is reserved for a future loader." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
